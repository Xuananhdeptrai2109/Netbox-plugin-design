# NetBox Configuration
NETBOX_URL=http://netbox:8080
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567

# Zabbix Configuration
ZABBIX_URL=http://zabbix-server:80/zabbix
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_TOKEN=

# Sync Settings
# Policy on remove: disable or delete
ZABBIX_DELETE_POLICY=disable
SYNC_INTERVAL_MINUTES=15
DEFAULT_ZABBIX_GROUP=NetBox Discovered Devices
DEFAULT_ZABBIX_TEMPLATE=Linux by Zabbix agent
